GOOGLE_API_KEY=your_google_ai_studio_api_key

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
PREFERRED_LANGUAGES=en,en-US,en-GB,hi,es,fr,de,ja,pt,ko
ALLOWED_ORIGINS=*
VECTORSTORE_DIR=vectorstores

# Optional: only needed if the backend fetches transcripts itself
# (not required when using the Chrome extension client-side fetch)
# YOUTUBE_PROXY_URL=http://user:pass@proxy-host:port
# WEBSHARE_PROXY_USERNAME=your_webshare_username
# WEBSHARE_PROXY_PASSWORD=your_webshare_password
