{
    "manifest_version": 3,
    "name": "YouTube RAG Assistant",
    "version": "1.2.0",
    "description": "Ask questions about any YouTube video using its transcript.",
    "permissions": [
        "sidePanel",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://*.onrender.com/*",
        "https://*.railway.app/*",
        "https://*.fly.dev/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Open YouTube RAG"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    }
}
